# Copy to .env and fill in for local development.
# core/config.py loads every one of these via Pydantic Settings — nothing is read
# from the environment anywhere else in the codebase (Global Rule 3).

ENVIRONMENT=local

# --- PostgreSQL (transactional DB) ---
# Host port is 5433, not the default 5432 — see docker-compose.yml (5432 was
# already taken by another local project on this machine).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=redirectiq
POSTGRES_PASSWORD=redirectiq
POSTGRES_DB=redirectiq
# Async SQLAlchemy URL, built from the pieces above if left unset.
DATABASE_URL=postgresql+asyncpg://redirectiq:redirectiq@localhost:5433/redirectiq

# --- Redis (cache, rate limits, streams) ---
# Host port is 6380, not the default 6379 — see docker-compose.yml.
REDIS_URL=redis://localhost:6380/0

# --- CORS (Global Rule 12) ---
# Comma-separated list. Never "*" — the frontend uses credentialed requests.
ALLOWED_ORIGINS=http://localhost:4321

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Redirect service ---
REDIRECT_HOST=0.0.0.0
REDIRECT_PORT=8001
